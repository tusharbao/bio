import pandas as pd


# 1. READ DATASET

# CSV file madhun RNA-Seq dataset read karto
# read_csv() function CSV file la DataFrame madhe convert karto

data = pd.read_csv("rna_seq.csv")


# Dataset cha heading print karto

print("RNA-Seq Dataset\n")

# Complete dataset display karto

print(data)


# 2. CALCULATE FOLD CHANGE

# Treated sample chi gene expression value
# Control sample chya expression value ne divide karto
# Donhi samples madhil gene expression cha ratio milto

data["Fold Change"] = data["Treated"] / data["Control"]


# Gene expression status store karnyasathi empty list create keli

status = []


# Fold Change column madhil pratyek value check karto

for fc in data["Fold Change"]:

    # Fold Change 2 kiwa tyapeksha jast asel
    # tar gene Upregulated consider karto

    if fc >= 2:

        status.append("Upregulated")

    # Fold Change 0.5 kiwa tyapeksha kami asel
    # tar gene Downregulated consider karto

    elif fc <= 0.5:

        status.append("Downregulated")

    # Fold Change 0.5 peksha jast ani 2 peksha kami asel
    # tar No Significant Change status deto

    else:

        status.append("No Significant Change")


# Calculated status dataset madhe navin column mhanun add karto

data["Status"] = status


# 3. DISPLAY DIFFERENTIAL GENE EXPRESSION

# Result cha heading print karto

print("\nDifferential Gene Expression\n")

# Final dataset Fold Change ani Status sahit display karto

print(data)













Q1. What is RNA-Seq?
Answer in English:

RNA-Seq stands for RNA Sequencing. It is a technique used to study gene expression by analyzing RNA molecules.

Answer in Marathi + English Mix:

RNA-Seq म्हणजे RNA Sequencing. ही technique वापरून sample मधील genes किती express होत आहेत हे analyze केले जाते.
Q2. What is the main purpose of RNA-Seq?
Answer in English:

The main purpose of RNA-Seq is to measure gene expression and identify changes in RNA levels.

Answer in Marathi + English Mix:

RNA-Seq चा main purpose म्हणजे gene expression measure करणे आणि RNA levels मधील changes identify करणे.
Q3. What is Gene Expression?
Answer in English:

Gene Expression is the process by which information from a gene is used to produce RNA or protein.

