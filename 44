# Pandas library import karto
# Dataset create ani manipulate karnyasathi Pandas use karto

import pandas as pd

# Dataset training ani testing madhe split karnyasathi function import karto

from sklearn.model_selection import train_test_split

# Random Forest Classification algorithm import karto

from sklearn.ensemble import RandomForestClassifier

# Model chi accuracy calculate karnyasathi function import karto

from sklearn.metrics import accuracy_score


# 1. CREATE GENOMIC DATASET

# Pandas DataFrame create karto
# GeneFeature1 ani GeneFeature2 he input features aahet
# Class ha output label aahe

data = pd.DataFrame({

    "GeneFeature1": [2.5, 1.2, 3.1, 0.9, 2.8,
                     1.0, 3.2, 0.8, 2.9, 1.1],

    "GeneFeature2": [3.0, 0.8, 3.5, 1.1, 2.9,
                     0.7, 3.8, 1.0, 3.1, 0.9],

    "Class": [
        "Healthy", "Disease", "Healthy", "Disease", "Healthy",
        "Disease", "Healthy", "Disease", "Healthy", "Disease"
    ]
})


# 2. SAVE DATASET AS CSV

# Dataset CSV file madhe save karto
# index=False mule extra index column save hot nahi

data.to_csv("genomic_data.csv", index=False)


# 3. READ DATASET

# Save keleli CSV file punha read karto

data = pd.read_csv("genomic_data.csv")


# Dataset cha heading print karto

print("Genomic Dataset\n")

# Complete dataset display karto

print(data)


# 4. SELECT FEATURES

# GeneFeature1 ani GeneFeature2 input features mhanun select karto
# X madhe model la dile janare input data store hoto

X = data[["GeneFeature1", "GeneFeature2"]]


# 5. SELECT TARGET

# Class column output target mhanun select karto
# Y madhe Healthy kiwa Disease labels astat

y = data["Class"]


# 6. SPLIT DATASET

# Dataset training ani testing data madhe divide karto

X_train, X_test, y_train, y_test = train_test_split(

    X,                  # Input features

    y,                  # Target labels

    test_size=0.3,      # 30% data testing sathi

    random_state=1,     # Same random split maintain karnyasathi

    stratify=y          # Donhi classes cha proportion maintain karto
)


# 7. CREATE RANDOM FOREST MODEL

# RandomForestClassifier model create karto
# n_estimators=100 mhanje 100 decision trees use hotat
# random_state=1 mule reproducible results miltat

model = RandomForestClassifier(
    n_estimators=100,
    random_state=1
)


# 8. TRAIN MODEL

# fit() function training data var model train karto
# Model input features ani output labels madhil patterns learn karto

model.fit(X_train, y_train)


# 9. PREDICTION

# predict() function test data var predictions karto

prediction = model.predict(X_test)


# Actual test labels display karto

print("\nActual Class")

print(y_test.values)


# Model ne predict kelele labels display karto

print("\nPredicted Class")

print(prediction)


# 10. CALCULATE ACCURACY

# Actual ani predicted values compare karun accuracy calculate karto

accuracy = accuracy_score(y_test, prediction)


# Accuracy percentage madhe display karto
# round() mule decimal nantar 2 digits display hotat

print("\nAccuracy:", round(accuracy * 100, 2), "%")










